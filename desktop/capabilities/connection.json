{
  "identifier": "connection",
  "description": "Only the embedded connection page may choose and check a Core URL. It may also move, minimize, maximize and close its frameless window.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-connection-info",
    "allow-connect-core",
    "allow-set-appearance",
    "core:window:allow-is-decorated",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
