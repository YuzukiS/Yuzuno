{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuzuno",
  "version": "0.1.0",
  "identifier": "dev.yuzuno.workspace",
  "build": {
    "frontendDist": "connection"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "connection"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true,
      "dangerousInsecureTransportProtocol": true
    }
  }
}
