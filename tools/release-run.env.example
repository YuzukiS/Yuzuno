# One release's values for tools/core-release-run.py (docs/core-release-checklist.md).
# Copy it to <W>/target/core.N-run/release-run.env, the release's run directory; W's target/ is
# ignored, so W stays clean. Python reads it: NAME=value, one per line, a comment after
# whitespace and #. A value has no spaces, quotes or shell characters. Leave a value blank
# until the step that finds it; each command refuses to start without the values it needs.
# Every path and number below is synthetic.

# The candidate: the head of main whose push CI passed.
SHA=0123456789abcdef0123456789abcdef01234567
CI_RUN=100000001                       # that CI run, ci.yml on the push of SHA to main
RELEASE_ID=core-20261109-0123456       # as the dispatch names it; ends with SHA's first 7
VERSION=2026.11.09-core.29             # the same day; the release's title
MILESTONE=core.29
PREV_TAG=core-20261108-89abcde         # the latest published release, the baseline

# Filled after gate passes and the release-inputs run is dispatched (inputs prints them).
INPUTS_RUN=
ARTIFACT_ID=

# Filled once the notes and the review string are final (their sha256).
NOTES_SHA256=
REVIEW_SHA256=

REPO=example-owner/example-repo
W=/srv/release/checkout/.worktrees/core29-release   # detached at SHA, clean; its tools run every step
T=/srv/release/checkout/target/core29               # the work directory is T/release
BASE=/srv/release/checkout/target/core28/release/bundle
BASE_SHA256=                           # baseline prints it, from the previous release's signed descriptor
PUB=/srv/release/keys/core-publisher.pub
PUB_SHA256=
KEY=/srv/release/keys/core-publisher.key   # a path only: passed to minisign, never read or copied
MINISIGN=/srv/release/bin/minisign
MINISIGN_SHA256=
WORKSPACE_ID=00000000-0000-4000-8000-000000000000   # from peers_list before the install
